# MongoDB Atlas (or any MongoDB) connection string. Required — the server
# refuses to start without it.
MONGO_URI=

# Port the Express/Socket.IO server listens on. Optional, defaults to 8000.
PORT=8000

# Comma-separated list of origins allowed by CORS (frontend URLs).
# Example: http://localhost:5173,https://meetify-frontend.onrender.com
CORS_WHITELIST=
